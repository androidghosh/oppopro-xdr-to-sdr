<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ProXDR → Punchy SDR"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pick a ProXDR photo or share one from Oppo Photos"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/imagePreview"
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:layout_marginTop="12dp"
            android:background="#1E1E1E"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/labelHighlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gainmap Highlight Boost (Bright Spots): 65%"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderHighlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="65"
                android:valueFrom="0"
                android:valueTo="150"
                android:stepSize="1" />

            <TextView
                android:id="@+id/labelShadow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Shadow Crush (Darken Dark Spots): 40%"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderShadow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="40"
                android:valueFrom="0"
                android:valueTo="100"
                android:stepSize="1" />

            <TextView
                android:id="@+id/labelContrast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="S-Curve Contrast &amp; Pop: 35%"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderContrast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="35"
                android:valueFrom="0"
                android:valueTo="100"
                android:stepSize="1" />

        </LinearLayout>

        <Button
            android:id="@+id/btnPick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Select ProXDR Photo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSave"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="Save to Gallery" />

            <Button
                android:id="@+id/btnShareWhatsApp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="Share to WhatsApp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
